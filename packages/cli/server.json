{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.lockstep-team-agent/lockstep",
  "description": "One source of truth for every engineering decision — captured from Slack, Notion, Jira, and PRs; briefed to every MCP agent at session start.",
  "repository": {
    "url": "https://github.com/lockstep-team-agent/lockstep",
    "source": "github"
  },
  "websiteUrl": "https://www.getlockstep.dev",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "lockstep-cli",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the Lockstep MCP server"
        }
      ]
    }
  ]
}
