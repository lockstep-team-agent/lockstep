# ---- Lockstep core configuration (12-factor) ----
# Same file shape for managed cloud and self-host; only values differ.

# Server
PORT=8080
NODE_ENV=development
# Public base URL of the core API (the CLI/MCP/Action talk to this)
LOCKSTEP_API_URL=http://localhost:8080

# Postgres (the single system-of-record)
DATABASE_URL=postgres://lockstep:lockstep@localhost:5432/lockstep
# App connects as a restricted, append-only-aware role (see migrations)
DATABASE_APP_ROLE=lockstep_app

# Secret used to sign/verify Lockstep session tokens (opaque tokens are hashed, this signs metadata)
TOKEN_SIGNING_SECRET=dev-only-change-me

# ---- GitHub App ----
# Managed cloud: our App. Self-host: the customer registers THEIR OWN App and fills these in.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=      # required for the dashboard "Sign in with GitHub" (web OAuth exchange)
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Register the dashboard's OAuth callback on the GitHub App: <dashboard-url>/login/github/callback

# ---- Dashboard (web) ----
# The dashboard's own public URL — used to build the GitHub OAuth redirect_uri (must match the
# callback registered on the App). Auto-derived from proxy headers if unset; set explicitly on Railway.
LOCKSTEP_WEB_URL=

# ---- Outbound (urgent pings) ----
SLACK_BOT_TOKEN=

# ---- v2 human-decision ingestion (packages/ingest worker) ----
# Composio connector key — used by core for OAuth initiation and by the worker for message fetch.
COMPOSIO_API_KEY=
# Shared service token the ingest worker presents to core's /ingest/* worker endpoints.
LOCKSTEP_INGEST_TOKEN=
# Voyage AI key for embedding-based fusion/supersession (core, optional — unset = Jaccard fallback).
VOYAGE_API_KEY=
# Anthropic key for LLM extraction. Worker: the distillation funnel (Haiku recall → Sonnet extract →
# Opus recheck). Core (optional): rewrites prose into rules when importing a repo's docs or a pasted
# brief. Unset on core = only sections that are already one imperative rule are imported, verbatim.
ANTHROPIC_API_KEY=
# Extraction model used by core's importer. Optional.
LOCKSTEP_EXTRACT_MODEL=claude-sonnet-4-6
# Set to 0 to refuse advisory code checks server-side, whatever a client asks for. Optional.
LOCKSTEP_CHECKS_ENABLED=1
# Typesafe Jev key (worker optional, core recommended). Worker: replaces the Haiku recall filter and
# the Opus borderline recheck with calibrated probabilities. Core: same_rule/replaces/unrelated
# verdicts lead the fusion scan, selects rules when importing docs without an Anthropic key, and
# backs the advisory decision checks. Unset on core = no doc import and no checks; fusion falls back
# to embeddings/Jaccard exactly as before.
TYPESAFE_API_KEY=
# Optional self-host connector backend (data-residency swap behind SourceConnector): lockstep-ingest sweep --nango
NANGO_SECRET_KEY=
NANGO_HOST=https://api.nango.dev

# ---- Web dashboard ----
# 1 = the concept-ledger dashboard (Inbox / Map / Ledger / Settings) for everyone; unset = current UI.
LOCKSTEP_NEW_UI=

# ---- Standards & Skills (set on core AND web; web also needs LOCKSTEP_NEW_UI=1) ----
LOCKSTEP_STANDARDS=
# S3-compatible object storage for skill packages (Railway Buckets in prod; `docker compose up minio` locally:
# BLOB_ENDPOINT=http://localhost:9000 BLOB_BUCKET=lockstep-skills BLOB_ACCESS_KEY_ID=lockstep BLOB_SECRET_ACCESS_KEY=lockstep-dev)
BLOB_ENDPOINT=
BLOB_BUCKET=
BLOB_REGION=auto
BLOB_ACCESS_KEY_ID=
BLOB_SECRET_ACCESS_KEY=
# Dev only, instead of S3: store blobs on local disk (authoring works; skill sync needs S3/MinIO)
BLOB_DIR=
# Optional: raises GitHub's rate limit for public skill imports
GITHUB_IMPORT_TOKEN=

# ---- Dev-mode login bypass ----
# Enables /auth/dev-login (no GitHub App needed). Never honored when NODE_ENV=production.
LOCKSTEP_DEV_LOGIN=1

# ---- Deployment mode ----
# "cloud" = multi-tenant SaaS; "self-host" = typically single-org
LOCKSTEP_DEPLOYMENT=self-host
